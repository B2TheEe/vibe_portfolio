# Kopieer dit bestand naar .env en vul de waarden in.
# Het .env bestand mag NOOIT in versiebeheer terechtkomen.

# Genereer een nieuwe key met:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=vervang-dit-met-een-veilige-geheime-sleutel

# Zet op False in productie
DJANGO_DEBUG=False

# Kommagescheiden lijst van toegestane hosts
# Voorbeeld: DJANGO_ALLOWED_HOSTS=mijnsite.nl,www.mijnsite.nl
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS-instellingen (zet op True in productie met HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# HSTS: seconden dat browsers HTTPS onthouden (bijv. 31536000 = 1 jaar)
SECURE_HSTS_SECONDS=0

# Admin-URL (wijzig dit in iets unieks voor jouw site)
DJANGO_ADMIN_URL=dashboard-beheer

# Database (laat leeg om lokaal SQLite te gebruiken)
# Voorbeeld: DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Cloudinary media-opslag
# Aanmaken via: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis cache (aanbevolen in productie voor correcte rate limiting bij meerdere workers)
# Laat leeg om lokaal LocMemCache te gebruiken
# Voorbeeld: REDIS_URL=redis://localhost:6379/0
REDIS_URL=
